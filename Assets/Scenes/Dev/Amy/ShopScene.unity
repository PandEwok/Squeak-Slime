  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ShopManager
  shopkeeperScript: {fileID: 1276527345}
  thankYouLines:
  - '"Thanks for the purchase!"'
  - '"Pleasure doing business with ya!"'
  - '"Use it well!"'
  - '"Don''t ask what I''ll do with these! Thank you very much!"'
  - '"Better be safe, am I right? Hehe!"'
  brokeLines:
  - '"No teeth? Aw, sadly I don''t give credit."'
  - '"I know how much you''re drooling for this one."'
  - '"Come back when you''re a little bit... richer."'
  - '"Hopefully you''re not too desperate for those."'
  winChance: 0.75
  goodOutcomeDiscount: -1
  minBadPenalty: 1
  maxBadPenalty: 3
  goodOutcomeColor: {r: 0, g: 1, b: 0, a: 1}
  badOutcomeColor: {r: 0.9056604, g: 0.34512562, b: 0.13243146, a: 1}
  happyPetLines:
  - '"Pyon?! I wasn''t expecting a head scratcher, thank you!"'
  - '" . . . brr..."'
  angryPetLines:
  - '"Hey! I didn''t ask you to pet me like that!"'
  - '"Who do you think you are?! I''m not to be sold!"'
  followUpGoodLines:
  - '"That was nice already, you can quit it here, thanks."'
  - '"You... really like bunnies that much?"'
  followUpBadLines:
  - '"Hey! I told you to stop that! Wasn''t that enough?!"'
  - '" . . . You''re looking for a fight or something?"'
  - '" . . . You''re lucky I''m not in a fighting mood either way..."'
  shopContainer: {fileID: 1118165113}
