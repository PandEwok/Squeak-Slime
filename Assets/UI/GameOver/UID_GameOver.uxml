<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="DeathScreen" picking-mode="Ignore" style="flex-grow: 1; width: 100%; height: 100%; position: absolute; top: 0; left: 0; bottom: 0; right: 0; -unity-text-align: upper-center; background-color: rgba(0, 0, 0, 0.51); align-items: center; justify-content: center; flex-direction: column; align-self: auto; align-content: auto; display: none; opacity: 1;">
        <ui:Label text="You are dead!" name="GameOverText" style="color: rgb(255, 0, 0); font-size: 77px;"/>
        <ui:Button text="Go to the lobby" name="ExitButtonGO" style="background-color: rgb(255, 0, 0); width: 400px; height: 150px;"/>
    </ui:VisualElement>
</ui:UXML>
