<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="DeathScreen" picking-mode="Ignore" style="flex-grow: 1; width: 100%; height: 100%; position: absolute; top: -1px; left: 0; bottom: 2px; right: 0; -unity-text-align: upper-center; background-color: rgba(0, 0, 0, 0.51); align-items: center; justify-content: center; flex-direction: column; align-self: auto; align-content: auto; display: flex; opacity: 1; max-width: initial; max-height: initial;">
        <ui:Label text="You are dead! Recap of this run:" name="GameOverText" style="color: rgb(255, 0, 0); font-size: 77px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Engcomica.otf?fileID=12800000&amp;guid=96c649ca54c11d540adde8d787c59125&amp;type=3#Engcomica&quot;); -unity-text-outline-width: 3px; -unity-text-outline-color: rgb(0, 0, 0);"/>
        <ui:Label text="Biome: Exterior of the castle " name="Biome" style="color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Engcomica.otf?fileID=12800000&amp;guid=96c649ca54c11d540adde8d787c59125&amp;type=3#Engcomica&quot;); font-size: 33px;"/>
        <ui:Label text="Floor: 10" name="Floor" style="color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Engcomica.otf?fileID=12800000&amp;guid=96c649ca54c11d540adde8d787c59125&amp;type=3#Engcomica&quot;); font-size: 33px;"/>
        <ui:VisualElement name="TeethRoot" style="flex-grow: 0; min-width: 0; min-height: 0;"/>
        <ui:Button text="Go to the lobby" name="ExitButtonGO" style="background-color: rgb(255, 0, 0); width: 400px; height: 150px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Engcomica.otf?fileID=12800000&amp;guid=96c649ca54c11d540adde8d787c59125&amp;type=3#Engcomica&quot;); font-size: 48px;"/>
    </ui:VisualElement>
</ui:UXML>
