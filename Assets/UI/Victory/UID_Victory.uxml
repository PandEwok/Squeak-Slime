<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="VictoryScreen" picking-mode="Ignore" style="flex-grow: 1; width: 100%; height: 100%; position: absolute; top: 0; left: 0; bottom: 0; right: 0; -unity-text-align: upper-center; background-color: rgb(217, 255, 192); align-items: center; justify-content: center; flex-direction: column; align-self: auto; align-content: auto; display: none;">
        <ui:Label text="You won! Recap etc coming soon..." name="VictoryText" style="color: rgb(253, 255, 0); font-size: 77px; -unity-text-outline-width: 3px; -unity-text-outline-color: rgb(0, 0, 0);"/>
        <ui:Button text="Next" name="ExitButtonV" style="background-color: rgb(255, 255, 255); height: 58px; width: 164px; font-size: 34px;"/>
    </ui:VisualElement>
</ui:UXML>
